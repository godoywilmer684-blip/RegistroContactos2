<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
    android:gravity="center_vertical" android:padding="10dp" android:background="#FFFFFF">
    <ImageView android:id="@+id/imgItemContacto" android:layout_width="58dp" android:layout_height="58dp"
        android:src="@android:drawable/ic_menu_myplaces" android:scaleType="centerCrop" android:contentDescription="Imagen del contacto"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:paddingStart="12dp">
        <TextView android:id="@+id/tvNombre" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Nombre del contacto" android:textSize="18sp" android:textStyle="bold" android:textColor="#123B64"/>
        <TextView android:id="@+id/tvTelefono" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Teléfono" android:textSize="15sp" android:textColor="#555555"/>
        <TextView android:id="@+id/tvPais" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="País" android:textSize="13sp" android:textColor="#777777"/>
    </LinearLayout>
</LinearLayout>
